{
  "name": "project-42-site",
  "version": "0.15.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node --test tests/brand-source-integrity.test.mjs && node scripts/generate-brand-assets.mjs --check",
    "diagrams:generate": "node scripts/generate-diagrams.mjs",
    "diagrams:check": "node --test tests/diagram-integrity.test.mjs",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "links:check": "node scripts/link-integrity.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:rendered && npm run test:links && npm run test:browser",
    "test:links": "node --test tests/link-integrity.test.mjs && npm run links:check",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run brand:check && npm run diagrams:check && npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@project42/platform": "github:project42dev/project42-platform#v0.37.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.47.0",
    "@mermaid-js/mermaid-cli": "11.15.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.1.8",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module",
  "allowScripts": {
    "github:project42dev/project42-platform#v0.37.0": true,
    "puppeteer": false
  }
}
